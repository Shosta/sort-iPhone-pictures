{
  "name": "photosort-electron",
  "productName": "Photosort",
  "version": "1.0.0-rc.1",
  "description": "Classement de photos par date EXIF - application Electron avec moteur Go",
  "homepage": "https://github.com/shosta/sort-iPhone-pictures",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "sidecar": "node scripts/build-sidecar.mjs",
    "ai-assets": "node scripts/fetch-ai-assets.mjs",
    "dev": "npm run sidecar && node scripts/rename-dev-electron.mjs && electron-vite dev",
    "build": "npm run sidecar && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/main/*.test.ts\" \"src/renderer/*.test.ts\" \"scripts/*.test.cjs\" \"scripts/*.test.mjs\"",
    "release": "node scripts/release.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "checksums": "node scripts/checksums.mjs release",
    "checksums:verify": "node scripts/checksums.mjs release --check",
    "dist": "npm run build && electron-builder && npm run checksums",
    "dist:mac": "npm run build && electron-builder --mac && npm run checksums",
    "dist:win": "npm run build && electron-builder --win && npm run checksums",
    "dist:linux": "npm run build && electron-builder --linux && npm run checksums"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8"
  }
}
