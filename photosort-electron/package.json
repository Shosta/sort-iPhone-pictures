{
  "name": "photosort-electron",
  "productName": "Photosort",
  "version": "0.1.0",
  "description": "Classement de photos par date EXIF - application Electron avec moteur Go",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "sidecar": "node scripts/build-sidecar.mjs",
    "ai-assets": "node scripts/fetch-ai-assets.mjs",
    "dev": "npm run sidecar && node scripts/rename-dev-electron.mjs && electron-vite dev",
    "build": "npm run sidecar && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
