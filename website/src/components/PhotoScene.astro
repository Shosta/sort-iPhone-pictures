---
// Mini « photo » illustrée, tons doux, pour la planche de l'accroche. Décor, pas de vraie photo.
interface Props {
  scene: 'portrait' | 'mountains' | 'cat' | 'beach' | 'city' | 'bird' | 'friends' | 'forest';
}
const { scene } = Astro.props;
const landscape = ['mountains', 'beach', 'city', 'friends'].includes(scene);
const viewBox = landscape ? '0 0 130 98' : '0 0 98 130';
---

<svg class="scene" viewBox={viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {
    scene === 'mountains' && (
      <>
        <rect width="130" height="98" fill="#dcd5c1" />
        <circle cx="96" cy="26" r="9" fill="#efe3c6" />
        <path d="M0 62 L24 34 L44 54 L66 26 L96 60 L116 44 L130 56 V70 H0Z" fill="#aab4a9" />
        <path d="M0 74 L30 48 L54 68 L82 44 L130 76 V80 H0Z" fill="#7f9084" />
        <rect y="74" width="130" height="24" fill="#a3b5b6" />
        <path d="M0 84 H130 M10 91 H90" stroke="#c2cfcd" stroke-width="1.2" />
        <path d="M0 98 V90 Q30 82 62 90 T130 88 V98Z" fill="#6f7a62" />
      </>
    )
  }
  {
    scene === 'beach' && (
      <>
        <rect width="130" height="50" fill="#ebcfae" />
        <rect y="50" width="130" height="48" fill="#efdcbc" />
        <circle cx="64" cy="48" r="18" fill="#f1bf92" />
        <rect y="48" width="130" height="22" fill="#a3b6b7" />
        <path d="M6 56 H46 M70 60 H120 M24 65 H80" stroke="#c6d3d1" stroke-width="1.4" />
        <path d="M0 98 V76 Q40 68 130 80 V98Z" fill="#dcc79f" />
        <path d="M28 24 q4 -4 8 0 q4 -4 8 0 M86 16 q3 -3 6 0 q3 -3 6 0" fill="none" stroke="#7c6d5c" stroke-width="1.2" stroke-linecap="round" />
      </>
    )
  }
  {
    scene === 'city' && (
      <>
        <rect width="130" height="98" fill="#cdd1cc" />
        <rect x="6" y="36" width="22" height="50" fill="#9a9c96" />
        <rect x="30" y="20" width="26" height="66" fill="#85887f" />
        <rect x="58" y="42" width="20" height="44" fill="#a7a79e" />
        <rect x="80" y="28" width="24" height="58" fill="#8c8f86" />
        <rect x="106" y="46" width="20" height="40" fill="#a1a299" />
        <path d="M36 28 h14 M36 38 h14 M36 48 h14 M36 58 h14 M86 36 h12 M86 46 h12 M86 56 h12 M12 46 h10 M12 56 h10 M112 56 h8" stroke="#d6d4c2" stroke-width="3" />
        <path d="M43 20 V10" stroke="#6e6b66" stroke-width="1.5" />
        <rect y="86" width="130" height="12" fill="#716d66" />
        <path d="M0 92 H130" stroke="#a09b8f" stroke-width="1" stroke-dasharray="6 5" />
      </>
    )
  }
  {
    scene === 'friends' && (
      <>
        <rect width="130" height="98" fill="#e6c8a6" />
        <circle cx="100" cy="30" r="12" fill="#f0d9b4" />
        <path d="M0 70 Q40 52 80 66 T130 62 V98 H0Z" fill="#a0a47c" />
        <path d="M0 82 Q50 72 130 80 V98 H0Z" fill="#838a63" />
        <g fill="#51473b">
          <circle cx="48" cy="46" r="6" />
          <path d="M40 80 Q40 56 48 54 Q56 56 56 80Z" />
          <circle cx="68" cy="50" r="5.4" />
          <path d="M61 82 Q61 60 68 58 Q75 60 75 82Z" />
          <circle cx="82" cy="62" r="3.8" />
          <path d="M77 84 Q77 68 82 67 Q87 68 87 84Z" />
        </g>
      </>
    )
  }
  {
    scene === 'portrait' && (
      <>
        <rect width="98" height="130" fill="#d2c3a4" />
        <path d="M10 130 Q12 96 49 92 Q86 96 88 130Z" fill="#8a6f5c" />
        <rect x="41" y="76" width="16" height="20" fill="#d8b698" />
        <ellipse cx="49" cy="58" rx="19" ry="23" fill="#e0bfa0" />
        <path d="M29 56 Q26 28 49 28 Q72 28 69 56 Q66 42 49 40 Q32 42 29 56Z" fill="#4c3b2f" />
        <circle cx="42" cy="60" r="1.6" fill="#4c3b2f" />
        <circle cx="56" cy="60" r="1.6" fill="#4c3b2f" />
        <path d="M43 71 Q49 75 55 71" fill="none" stroke="#a9694f" stroke-width="1.6" stroke-linecap="round" />
      </>
    )
  }
  {
    scene === 'cat' && (
      <>
        <rect width="98" height="130" fill="#cbc4aa" />
        <rect x="0" y="100" width="98" height="30" fill="#a89a80" />
        <path d="M26 112 Q20 78 38 70 H62 Q80 78 74 112Z" fill="#8f7d6a" />
        <path d="M74 108 Q96 106 90 84" fill="none" stroke="#8f7d6a" stroke-width="7" stroke-linecap="round" />
        <circle cx="50" cy="54" r="19" fill="#8f7d6a" />
        <path d="M33 44 L34 24 L47 36Z M67 44 L66 24 L53 36Z" fill="#8f7d6a" />
        <path d="M36 32 L37 40 L42 36Z M64 32 L63 40 L58 36Z" fill="#c9a28f" />
        <ellipse cx="43" cy="52" rx="3" ry="3.6" fill="#e9dfa8" />
        <ellipse cx="57" cy="52" rx="3" ry="3.6" fill="#e9dfa8" />
        <path d="M43 49 V55 M57 49 V55" stroke="#3f352c" stroke-width="1.4" />
        <path d="M47 60 L53 60 L50 63Z" fill="#b87d6c" />
        <path d="M30 92 H68 M34 82 H66" stroke="#74624f" stroke-width="2.2" opacity=".6" />
      </>
    )
  }
  {
    scene === 'bird' && (
      <>
        <rect width="98" height="130" fill="#b9c6c4" />
        <circle cx="22" cy="24" r="14" fill="#dbe0d2" opacity=".7" />
        <path d="M0 92 Q40 84 98 96" fill="none" stroke="#5f4e3e" stroke-width="4" stroke-linecap="round" />
        <path d="M70 92 q14 -14 24 -8 q-8 14 -24 8Z M20 90 q-10 -16 -22 -12 q8 16 22 12Z" fill="#7d936c" />
        <ellipse cx="50" cy="70" rx="17" ry="20" fill="#8b7866" />
        <ellipse cx="52" cy="76" rx="11" ry="13" fill="#bf6a50" />
        <circle cx="48" cy="46" r="11" fill="#8b7866" />
        <path d="M38 46 L28 49 L38 52Z" fill="#c9a24f" />
        <circle cx="46" cy="44" r="1.8" fill="#352c25" />
        <path d="M64 70 L86 84 L66 82Z" fill="#6f5f50" />
        <path d="M45 92 V100 M55 92 V100" stroke="#6f5f50" stroke-width="1.6" />
      </>
    )
  }
  {
    scene === 'forest' && (
      <>
        <rect width="98" height="130" fill="#c6cdb4" />
        <rect y="96" width="98" height="34" fill="#8e8e60" />
        <rect x="14" y="40" width="7" height="68" fill="#6b5c48" />
        <rect x="46" y="22" width="9" height="90" fill="#625441" />
        <rect x="76" y="48" width="6" height="62" fill="#6b5c48" />
        <ellipse cx="18" cy="38" rx="17" ry="24" fill="#7f9368" />
        <ellipse cx="50" cy="26" rx="22" ry="28" fill="#6c8259" />
        <ellipse cx="79" cy="46" rx="15" ry="22" fill="#85996e" />
        <path d="M0 110 Q50 100 98 112" fill="none" stroke="#a8a577" stroke-width="3" />
      </>
    )
  }
</svg>
