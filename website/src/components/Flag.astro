---
interface Props {
  lang: 'fr' | 'en' | 'da';
}
const { lang } = Astro.props;
---

<svg class="flag" viewBox="0 0 30 20" width="24" height="16" aria-hidden="true" focusable="false">
  {
    lang === 'fr' && (
      <>
        <rect width="10" height="20" fill="#2a4a9b" />
        <rect x="10" width="10" height="20" fill="#fbfaf6" />
        <rect x="20" width="10" height="20" fill="#c8322b" />
      </>
    )
  }
  {
    lang === 'en' && (
      <>
        <rect width="30" height="20" fill="#27407f" />
        <path d="M0 0 L30 20 M30 0 L0 20" stroke="#fbfaf6" stroke-width="4" />
        <path d="M0 0 L30 20 M30 0 L0 20" stroke="#c8322b" stroke-width="1.6" />
        <path d="M15 0 V20 M0 10 H30" stroke="#fbfaf6" stroke-width="6.5" />
        <path d="M15 0 V20 M0 10 H30" stroke="#c8322b" stroke-width="3.6" />
      </>
    )
  }
  {
    lang === 'da' && (
      <>
        <rect width="30" height="20" fill="#c8322b" />
        <path d="M10 0 V20 M0 10 H30" stroke="#fbfaf6" stroke-width="3.4" />
      </>
    )
  }
</svg>
