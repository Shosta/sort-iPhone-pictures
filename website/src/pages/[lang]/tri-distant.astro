---
import Print from '../../components/Print.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { copies, languages, type Lang } from '../../i18n';
import { nasCopies } from '../../i18n/nas';
import '../../styles/global.css';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copies[lang];
const n = nasCopies[lang];

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
const slug = 'tri-distant/';
const pageUrl = (l: string) => `${home}${l}/${slug}`;
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

const repositoryUrl = import.meta.env.PUBLIC_REPOSITORY_URL?.trim();
if (repositoryUrl && new URL(repositoryUrl).protocol !== 'https:') {
  throw new Error('PUBLIC_REPOSITORY_URL doit être une URL HTTPS.');
}
const d = n.why.diagram;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{n.meta.title}</title>
    <meta name="description" content={n.meta.description} />
    <meta name="theme-color" content="#f4ecdd" />
    <link rel="canonical" href={absolute(pageUrl(lang))} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={absolute(pageUrl(l))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(pageUrl('fr'))} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={n.meta.title} />
    <meta property="og:description" content={n.meta.description} />
    <link rel="icon" href={`${home}favicon-16.png`} type="image/png" sizes="16x16" />
    <link rel="icon" href={`${home}favicon-32.png`} type="image/png" sizes="32x32" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t.skip}</a>
    <SiteHeader lang={lang} path={slug} onHome={false} />

    <main id="contenu" class="guide">
      <header class="guide-hero shell">
        <a class="text-link" href={`${home}${lang}/`}>{n.hero.back}</a>
        <p class="eyebrow">{n.hero.eyebrow}</p>
        <h1>{n.hero.title}</h1>
        <p class="lead">{n.hero.lead}</p>
        <nav class="toc" aria-label={n.toc.label}>
          <ul>
            {n.toc.items.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
          </ul>
        </nav>
      </header>

      <section class="section guide-section shell" id="pourquoi" aria-labelledby="why-title">
        <h2 id="why-title">{n.why.title}</h2>
        <p class="lead">{n.why.lead}</p>
        <figure class="flow">
          <svg viewBox="0 0 760 190" role="img" aria-labelledby="flow-title">
            <title id="flow-title">{d.alt}</title>
            <defs>
              <marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                <path d="M0 0 10 5 0 10z" fill="#b3362b" />
              </marker>
            </defs>
            <g fill="#fbf6ea" stroke="#1d1a16" stroke-width="2">
              <rect x="10" y="50" width="170" height="90" rx="6" />
              <rect x="295" y="50" width="170" height="90" rx="6" />
              <rect x="580" y="50" width="170" height="90" rx="6" />
            </g>
            <g font-family="'IBM Plex Mono', monospace" fill="#1d1a16" text-anchor="middle">
              <text x="95" y="88" font-size="17" font-weight="500">{d.mac}</text>
              <text x="95" y="114" font-size="13" fill="#5f574c">{d.local}</text>
              <text x="380" y="88" font-size="17" font-weight="500">Photosort</text>
              <text x="380" y="114" font-size="13" fill="#5f574c">{d.local}</text>
              <text x="665" y="88" font-size="17" font-weight="500">{d.nas}</text>
              <text x="665" y="114" font-size="13" fill="#5f574c">{d.sent}</text>
              <text x="237" y="32" font-size="13" fill="#b3362b">{d.sort}</text>
              <text x="522" y="32" font-size="13" fill="#b3362b">{d.rsync}</text>
            </g>
            <g stroke="#b3362b" stroke-width="3" fill="none" marker-end="url(#flow-arrow)">
              <path d="M184 95H289" />
              <path d="M469 95H574" stroke-dasharray="8 6" />
            </g>
          </svg>
        </figure>
        <ul class="cards">
          {n.why.items.map((item) => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}
        </ul>
      </section>

      <section class="section guide-section shell" id="prerequis" aria-labelledby="prereq-title">
        <h2 id="prereq-title">{n.prereq.title}</h2>
        <div class="two-col">
          <div>
            <h3>{n.prereq.qnap.title}</h3>
            <p>{n.prereq.qnap.intro}</p>
            <ol class="numbered">
              {n.prereq.qnap.steps.map((step) => <li>{step}</li>)}
            </ol>
            <p class="info-note">{n.prereq.qnap.note}</p>
          </div>
          <div>
            <h3>{n.prereq.ssh.title}</h3>
            <p>{n.prereq.ssh.text}</p>
            <h3 class="spaced">{n.prereq.mac.title}</h3>
            <p>{n.prereq.mac.text}</p>
            <pre class="code"><code>brew install rsync</code></pre>
            <p class="info-note">{n.prereq.mac.check}</p>
            <p class="info-note">{n.prereq.mac.other}</p>
          </div>
        </div>
      </section>

      <section class="section guide-section shell" id="pas-a-pas" aria-labelledby="steps-title">
        <h2 id="steps-title">{n.steps.title}</h2>
        <p class="lead">{n.steps.lead}</p>
        <p class="spaced">{n.steps.open}</p>
        <div class="steps-layout">
          <dl class="fields">
            {n.steps.fields.map((field, index) => (
              <div>
                <dt><span class="step-no" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span> {field.label}</dt>
                <dd>{field.text}</dd>
              </div>
            ))}
          </dl>
          <Print class="guide-print" name="tri-distant-fenetre" alt={n.steps.shotAlt} caption={n.steps.shotCaption} pending={n.steps.pending} tilt={1.2} />
        </div>
        <h3 class="spaced">{n.steps.sortTitle}</h3>
        <p>{n.steps.sortText}</p>
      </section>

      <section class="section guide-section shell" id="tester" aria-labelledby="test-title">
        <h2 id="test-title">{n.test.title}</h2>
        <p>{n.test.text}</p>
        <ul class="outcomes">
          <li class="ok">{n.test.ok}</li>
          <li class="ok">{n.test.pathMissing}</li>
        </ul>
        <p>{n.test.error}</p>
      </section>

      <section class="section guide-section shell" id="simuler" aria-labelledby="dry-title">
        <h2 id="dry-title">{n.dry.title}</h2>
        <p>{n.dry.text}</p>
        <p class="quote">{n.dry.result}</p>
        <p>{n.dry.then}</p>
        <ul class="cards cards-3">
          {n.safety.items.map((item) => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}
        </ul>
      </section>

      <section class="section guide-section shell" id="dossier" aria-labelledby="library-title">
        <h2 id="library-title">{n.library.title}</h2>
        <p class="lead">{n.library.lead}</p>
        <ul class="cards">
          {n.library.items.map((item) => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}
        </ul>
      </section>

      <section class="section guide-section shell" id="depannage" aria-labelledby="trouble-title">
        <h2 id="trouble-title">{n.trouble.title}</h2>
        <p class="lead">{n.trouble.lead}</p>
        <ul class="trouble">
          {n.trouble.items.map((item) => (
            <li>
              <p class="trouble-message"><span class="sr-only">{n.trouble.columns.message} : </span>{item.message}</p>
              <p class="trouble-fix"><strong>{n.trouble.columns.fix} — </strong>{item.fix}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="section guide-section shell" id="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">{n.faq.title}</h2>
        <div class="faq">
          {n.faq.items.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
        </div>
        <h3 class="spaced">{n.cli.title}</h3>
        <p>{n.cli.text}</p>
        <pre class="code"><code>photosort --source ~/Photos --remote rsync://alice@nas.local/Photos --remote-test
photosort --source ~/Photos --remote rsync://alice@nas.local/Photos --remote-dry-run
photosort --source ~/Photos --remote rsync://alice@nas.local/Photos --apply</code></pre>
      </section>
    </main>

    <SiteFooter lang={lang} repositoryUrl={repositoryUrl} />
  </body>
</html>
