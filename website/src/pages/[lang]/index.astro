---
import { Image } from 'astro:assets';
import photosortIcon from '../../assets/photosort.png';
import Herbarium from '../../components/Herbarium.astro';
import Print from '../../components/Print.astro';
import ScrapbookSheet from '../../components/ScrapbookSheet.astro';
import Stamp from '../../components/Stamp.astro';
import Flag from '../../components/Flag.astro';
import { copies, languages, type Lang } from '../../i18n';
import '../../styles/global.css';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copies[lang];
const languageNames: Record<Lang, string> = { fr: 'Français', en: 'English', da: 'Dansk' };

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
const pageUrl = (l: string) => `${home}${l}/`;
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

const repositoryUrl = import.meta.env.PUBLIC_REPOSITORY_URL?.trim();
if (repositoryUrl && new URL(repositoryUrl).protocol !== 'https:') {
  throw new Error('PUBLIC_REPOSITORY_URL doit être une URL HTTPS.');
}
const releasesUrl = repositoryUrl ? `${repositoryUrl.replace(/\/$/, '')}/releases/latest` : undefined;

const tilts = [-2.2, 1.6, -1.2, 2.4];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#f4ecdd" />
    <link rel="canonical" href={absolute(pageUrl(lang))} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={absolute(pageUrl(l))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(home)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <link rel="icon" href={`${home}favicon-16.png`} type="image/png" sizes="16x16" />
    <link rel="icon" href={`${home}favicon-32.png`} type="image/png" sizes="32x32" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t.skip}</a>

    <header class="site-header shell">
      <a class="brand" href={pageUrl(lang)} aria-label="Photosort">
        <Image src={photosortIcon} width={36} height={36} densities={[1, 2, 3]} format="webp" loading="eager" alt="" />
        <span>photosort</span>
      </a>
      <nav aria-label={t.nav.label}>
        <a href="#classement">{t.nav.how}</a>
        <a href="#fonctions">{t.nav.features}</a>
        <a href="#semainier">{t.nav.scrapbook}</a>
        <a href="#telecharger">{t.nav.download}</a>
        <a href="#faq">{t.nav.faq}</a>
      </nav>
      <details class="lang-menu">
        <summary aria-label={t.nav.languages}>
          <Flag lang={lang} />
          <span>{languageNames[lang]}</span>
        </summary>
        <ul>
          {languages.map((l) => (
            <li>
              <a href={pageUrl(l)} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
                <Flag lang={l} />
                <span>{languageNames[l]}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </header>

    <main id="contenu">
      <section class="hero shell" aria-labelledby="hero-title">
        <Herbarium variant="fern" class="herb-hero" />
        <div class="hero-copy">
          <p class="eyebrow">{t.hero.eyebrow}</p>
          <h1 id="hero-title"><span class="h1-a">{t.hero.titleA}</span> <em>{t.hero.titleB}</em></h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="actions">
            <a class="button button-primary" href="#classement">{t.hero.ctaHow}</a>
            <a class="text-link" href="#telecharger">{t.hero.ctaDownload} <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note">{t.hero.note}</p>
        </div>
        <div class="hero-art">
          <ScrapbookSheet caption={t.hero.sheetCaption} alt={t.hero.sheetAlt} />
          <Stamp id="hero" class="stamp-hero" top={t.stamp.top} main={t.stamp.main} bottom={t.stamp.bottom} />
        </div>
      </section>

      <section class="section shell" id="classement" aria-labelledby="how-title">
        <div class="section-heading">
          <p class="eyebrow">{t.how.eyebrow}</p>
          <h2 id="how-title">{t.how.title}</h2>
        </div>
        <ol class="steps">
          {t.how.items.map((step, index) => (
            <li><span class="step-no" aria-hidden="true">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>
          ))}
        </ol>
        <p class="info-note">{t.how.note}</p>
      </section>

      <section class="section features shell" id="fonctions" aria-labelledby="features-title">
        <Herbarium variant="oak" class="herb-oak" />
        <Herbarium variant="grass" class="herb-grass" />
        <div class="section-heading">
          <p class="eyebrow">{t.features.eyebrow}</p>
          <h2 id="features-title">{t.features.title}</h2>
          <p class="lead">{t.features.lead}</p>
        </div>
        <ul class="specimens">
          {t.features.items.map((item, index) => (
            <li class="specimen" style={`--i:${index}`}>
              <p class="specimen-no">{t.features.specimen} n° {String(index + 1).padStart(2, '0')}</p>
              <h3>{item.name}</h3>
              <p class="latin">{item.latin}</p>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="section scrapbook shell" id="semainier" aria-labelledby="scrapbook-title">
        <Herbarium variant="ginkgo" class="herb-scrapbook" />
        <div class="scrapbook-intro">
          <p class="eyebrow">{t.scrapbook.eyebrow}</p>
          <h2 id="scrapbook-title">{t.scrapbook.title}</h2>
          <p class="lead">{t.scrapbook.lead}</p>
        </div>
        <ol class="week-steps">
          {t.scrapbook.steps.map((step, index) => (
            <li><span class="numeral" aria-hidden="true">{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>
          ))}
        </ol>
        <dl class="facts">
          {t.scrapbook.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        </dl>
        <p class="kbd-note">{t.scrapbook.note}</p>
      </section>

      <section class="section shots shell" aria-labelledby="shots-title">
        <div class="section-heading">
          <p class="eyebrow">{t.shots.eyebrow}</p>
          <h2 id="shots-title">{t.shots.title}</h2>
        </div>
        <div class="print-board">
          {t.shots.items.map((shot, index) => (
            <Print class={`print--${index + 1}`} name={shot.key} alt={shot.alt} caption={shot.caption} pending={t.shots.pending} tilt={tilts[index]} />
          ))}
        </div>
      </section>

      <section class="section download shell" id="telecharger" aria-labelledby="download-title">
        <Herbarium variant="fern" class="herb-download" />
        <div class="download-copy">
          <p class="eyebrow">{t.download.eyebrow}</p>
          <h2 id="download-title">{t.download.title}</h2>
          <p class="lead">{t.download.lead}</p>
          <ul class="platforms">
            {t.download.platforms.map((p) => <li><strong>{p.os}</strong><span>{p.detail}</span></li>)}
          </ul>
          {
            releasesUrl && repositoryUrl ? (
              <div class="actions">
                <a class="button button-primary" href={releasesUrl} target="_blank" rel="noopener noreferrer">{t.download.button} <span aria-hidden="true">↗</span></a>
                <a class="text-link" href={repositoryUrl} target="_blank" rel="noopener noreferrer">{t.download.repoButton} <span aria-hidden="true">↗</span></a>
              </div>
            ) : (
              <p class="availability-note">{t.download.pendingRepo}</p>
            )
          }
          <p class="fine-print">{t.download.unsigned}</p>
        </div>
        <Stamp id="download" class="stamp-small" top={t.stamp.top} main={t.stamp.main} bottom={t.stamp.bottom} />
      </section>

      <section class="section split shell" id="faq" aria-labelledby="faq-title">
        <div class="limits">
          <p class="eyebrow">{t.limits.eyebrow}</p>
          <h2>{t.limits.title}</h2>
          <ul>{t.limits.items.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="faq">
          <p class="eyebrow">{t.faq.eyebrow}</p>
          <h2 id="faq-title">{t.faq.title}</h2>
          {t.faq.items.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <a class="brand" href={pageUrl(lang)}>
        <Image src={photosortIcon} width={30} height={30} densities={[1, 2, 3]} format="webp" loading="lazy" alt="" />
        <span>photosort</span>
      </a>
      <p>{t.footer.tagline}</p>
      <p class="fine-print">{t.footer.independent} · {repositoryUrl ? <a href={`${repositoryUrl.replace(/\/$/, '')}/blob/main/LICENSE`} rel="noopener noreferrer">{t.footer.license}</a> : t.footer.license}</p>
    </footer>
  </body>
</html>
