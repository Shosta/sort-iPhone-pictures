---
import Print from '../../components/Print.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { copies, languages, type Lang } from '../../i18n';
import { home as homeCopies } from '../../i18n/home';
import '../../styles/global.css';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copies[lang];
const h = homeCopies[lang];

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
const pageUrl = (l: string) => `${home}${l}/`;
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

const repositoryUrl = import.meta.env.PUBLIC_REPOSITORY_URL?.trim();
if (repositoryUrl && new URL(repositoryUrl).protocol !== 'https:') {
  throw new Error('PUBLIC_REPOSITORY_URL doit être une URL HTTPS.');
}
// PUBLIC_HAS_RELEASE = une version stable existe (/releases/latest ignore les préversions).
// Sans version stable, on pointe vers la liste des releases ; PUBLIC_HAS_PRERELEASE précise qu'une préversion y figure.
const hasRelease = import.meta.env.PUBLIC_HAS_RELEASE === 'true';
const hasPrerelease = !hasRelease && import.meta.env.PUBLIC_HAS_PRERELEASE === 'true';
const repoBase = repositoryUrl?.replace(/\/$/, '');
const downloadUrl = repoBase ? (hasRelease ? `${repoBase}/releases/latest` : `${repoBase}/releases`) : undefined;
const mainLabel = hasRelease ? h.download.generic : hasPrerelease ? h.download.prerelease : h.download.soon;
const tilts = [1.4, -1.6, 1.2, -1.4, 1.6, -1.2];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{h.meta.title}</title>
    <meta name="description" content={h.meta.description} />
    <meta name="theme-color" content="#f4ecdd" />
    <link rel="canonical" href={absolute(pageUrl(lang))} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={absolute(pageUrl(l))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(home)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={h.meta.title} />
    <meta property="og:description" content={h.meta.description} />
    <link rel="icon" href={`${home}favicon-16.png`} type="image/png" sizes="16x16" />
    <link rel="icon" href={`${home}favicon-32.png`} type="image/png" sizes="32x32" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t.skip}</a>

    <SiteHeader lang={lang} />

    <main id="contenu">
      <section class="product-hero shell" aria-labelledby="hero-title">
        <p class="eyebrow">{h.hero.eyebrow}</p>
        <h1 id="hero-title">{h.hero.title}</h1>
        <p class="lead">{h.hero.subtitle}</p>
        <div class="actions">
          <a id="download-main" class="button button-primary" href={downloadUrl ?? '#telecharger'} rel={downloadUrl ? 'noopener noreferrer' : undefined}>{mainLabel}</a>
          <a class="text-link" href={`${home}${lang}/presentation/`}>{h.more.cta} <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note">{h.hero.note}</p>
        <Print class="print--hero" name="hero" alt={h.hero.alt} caption={h.hero.caption} pending={t.shots.pending} tilt={-0.8} sizes="(min-width: 1100px) 1000px, 94vw" widths={[640, 1000, 1600]} eager />
      </section>

      {
        h.sections.map((s, i) => (
          <section class={`product-section shell${i % 2 ? ' is-reversed' : ''}`} id={s.id} aria-labelledby={`${s.id}-title`}>
            <div class="product-copy">
              <p class="eyebrow">{s.eyebrow}</p>
              <h2 id={`${s.id}-title`}>{s.title}</h2>
              <p>{s.text}</p>
              <ul class="ticks">{s.bullets.map((b) => <li>{b}</li>)}</ul>
            </div>
            <Print class="print--product" name={s.shot} alt={s.alt} caption={s.caption} pending={t.shots.pending} tilt={tilts[i]} sizes="(min-width: 900px) 600px, 94vw" widths={[480, 800, 1200]} />
          </section>
        ))
      }

      <section class="section shell" id="fonctions" aria-labelledby="features-title">
        <p class="eyebrow">{h.features.eyebrow}</p>
        <h2 id="features-title" class="section-heading">{h.features.title}</h2>
        <ul class="feature-grid">
          {h.features.items.map((f) => <li><strong>{f.name}</strong><span>{f.text}</span></li>)}
        </ul>
      </section>

      <section class="section shell free-block" aria-labelledby="free-title">
        <p class="eyebrow">{h.free.eyebrow}</p>
        <h2 id="free-title">{h.free.title}</h2>
        <p class="lead">{h.free.text}</p>
        <ul class="ticks ticks--row">{h.free.items.map((i) => <li>{i}</li>)}</ul>
      </section>

      <section class="section shell download-block" id="telecharger" aria-labelledby="download-title">
        <p class="eyebrow">{h.download.eyebrow}</p>
        <h2 id="download-title">{h.download.title}</h2>
        <p class="lead">{h.download.lead}</p>
        {
          downloadUrl ? (
            <>
              <div class="actions">
                <a id="download-cta" class="button button-primary" href={downloadUrl} rel="noopener noreferrer">{mainLabel}</a>
              </div>
              {!hasRelease && <p class="availability-note">{hasPrerelease ? h.download.prereleaseNote : h.download.soonNote}</p>}
              <h3 class="others-title">{h.download.others}</h3>
              <ul class="platforms platforms--links">
                {h.download.platforms.map((p) => (
                  <li>
                    <a href={downloadUrl} rel="noopener noreferrer" data-os={p.key}>
                      <strong>{p.os}</strong>
                      <span>{p.detail}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="fine-print"><a href={repoBase} rel="noopener noreferrer">{h.download.source}</a></p>
            </>
          ) : (
            <p class="availability-note">{h.download.pendingRepo}</p>
          )
        }
        <p class="fine-print">{h.download.unsigned}</p>
      </section>
    </main>

    <SiteFooter lang={lang} repositoryUrl={repositoryUrl} />
    {
      downloadUrl && hasRelease && (
        <script is:inline define:vars={{ labels: h.download.forOs }}>
          var u = navigator.userAgent;
          var os = /Android|iPhone|iPad/.test(u) ? '' : /Mac/.test(u) ? 'mac' : /Win/.test(u) ? 'windows' : /Linux|X11/.test(u) ? 'linux' : '';
          if (os) ['download-main', 'download-cta'].forEach(function (id) { var el = document.getElementById(id); if (el) el.textContent = labels[os]; });
        </script>
      )
    }
  </body>
</html>
