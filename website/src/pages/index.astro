---
import { Image } from 'astro:assets';
import photosortIcon from '../assets/photosort.png';
import '../styles/global.css';

const home = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const repositoryUrl = import.meta.env.PUBLIC_REPOSITORY_URL?.trim();
if (repositoryUrl) {
  const url = new URL(repositoryUrl);
  if (url.protocol !== 'https:') {
    throw new Error('PUBLIC_REPOSITORY_URL doit être une URL HTTPS.');
  }
}

const benefits = [
  { icon: '01', title: 'La vraie date, pas celle du transfert.', text: 'Photosort utilise la date de prise de vue inscrite dans les métadonnées EXIF. Un souvenir de juillet reste en juillet, même si vous le copiez en décembre.' },
  { icon: '02', title: 'Vos originaux restent intacts.', text: 'Les photos sont copiées vers un nouveau dossier, sans déplacer ni renommer les originaux. Aucun fichier existant n’est écrasé.' },
  { icon: '03', title: 'Vos photos restent chez vous.', text: 'Tout se passe sur votre ordinateur. Pas de compte à créer, pas de serveur et aucune photo envoyée dans le cloud.' },
];

const steps = [
  { title: 'Récupérez vos photos', text: 'Transférez les originaux de votre iPhone vers un dossier de votre ordinateur avec votre outil habituel. Photosort prend le relais après ce transfert.' },
  { title: 'Choisissez vos dossiers', text: 'Ajoutez un ou plusieurs dossiers sources dans l’application, puis choisissez une destination distincte pour votre bibliothèque classée.' },
  { title: 'Laissez les dates faire le tri', text: 'Photosort analyse les métadonnées et copie les photos classables dans des dossiers par année et par mois, avec des noms lisibles.' },
];

const faqs = [
  { question: 'Est-ce que Photosort importe directement depuis mon iPhone ?', answer: 'Non. Cette version travaille sur des dossiers accessibles depuis votre ordinateur. Récupérez d’abord vos photos avec votre outil de transfert habituel, en conservant les originaux et leurs métadonnées. La connexion et le transfert depuis l’iPhone ne sont pas réalisés par Photosort.' },
  { question: 'Quels formats de photos sont pris en charge ?', answer: 'Photosort examine notamment les JPEG, HEIC/HEIF, PNG, TIFF, AVIF et plusieurs formats RAW. Le classement dépend de la présence de métadonnées EXIF lisibles et d’une date de prise de vue. Les PNG sans EXIF ne sont donc pas classables.' },
  { question: 'Que se passe-t-il si une photo n’a pas de date EXIF ?', answer: 'Elle est ignorée et signalée dans le bilan. Photosort ne remplace pas une date de prise de vue absente par la date de modification du fichier. L’original reste inchangé.' },
  { question: 'Les vidéos et les Live Photos sont-elles gérées ?', answer: 'Non. Les vidéos, les Live Photos en tant qu’ensemble photo + vidéo et les fichiers annexes XMP/AAE ne sont pas gérés. Photosort se concentre pour le moment sur les fichiers photo disposant de métadonnées compatibles.' },
  { question: 'Est-ce que l’application supprime les doublons ?', answer: 'Non. Elle ne détecte pas encore les doublons de contenu. Relancer un classement sur les mêmes photos crée de nouvelles copies avec de nouveaux numéros ; il ne s’agit pas d’un outil de synchronisation.' },
  { question: 'Sur quels systèmes puis-je l’utiliser ?', answer: 'Le projet propose une interface graphique et une ligne de commande pour macOS et Linux. Le packaging Linux cible x86_64. Les applications distribuées restent à tester sur votre machine ; le bundle macOS actuel n’est pas notarisé par Apple. Windows n’est pas une cible prise en charge actuellement.' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Retrouvez une bibliothèque lisible avec Photosort : classez les photos récupérées depuis votre iPhone par date EXIF, sur votre ordinateur, sans modifier les originaux. Un projet open source pour macOS et Linux." />
    <meta name="theme-color" content="#214e3b" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content="Photosort — Vos souvenirs, enfin à leur place." />
    <meta property="og:description" content="Des photos en vrac à une bibliothèque organisée. Un outil open source, local et respectueux de vos originaux." />
    <title>Photosort — Vos souvenirs, enfin à leur place.</title>
    <link rel="icon" href={`${home}favicon-16.png`} type="image/png" sizes="16x16" />
    <link rel="icon" href={`${home}favicon-32.png`} type="image/png" sizes="32x32" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header shell">
      <a class="brand" href={home} aria-label="Photosort, accueil">
        <Image src={photosortIcon} width={36} height={36} densities={[1, 2, 3]} format="webp" loading="eager" alt="" />
        <span>photosort<span class="brand-dot">.</span></span>
      </a>
      <nav aria-label="Navigation principale">
        <a href="#fonctionnement">Comment ça marche</a>
        <a href="#questions">FAQ</a>
        <a class="nav-cta" href="#communaute">Le projet <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="contenu">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> OPEN SOURCE · LOCAL · SANS COMPTE</p>
          <h1 id="hero-title">Vos souvenirs,<br />enfin <span class="serif">à leur place.</span></h1>
          <p class="hero-description">Des milliers de photos d’iPhone. Des noms de fichiers qui ne racontent rien. Photosort les classe à partir de leur date de prise de vue pour retrouver une bibliothèque qui a du sens.</p>
          <div class="actions">
            <a class="button button-primary" href="#commencer">Découvrir Photosort <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#classement">Voir le résultat <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note"><span aria-hidden="true">✓</span> macOS & Linux <span class="note-divider">/</span> Vos originaux sont conservés</p>
        </div>

        <div class="hero-art" role="img" aria-label="Illustration du classement : des photos éparpillées deviennent des dossiers organisés par année et par mois.">
          <div class="art-grid"></div>
          <div class="photo photo-back"><div class="landscape sea"></div><span>IMG_2048.HEIC</span></div>
          <div class="photo photo-front"><div class="landscape hills"><span class="sun"></span></div><span>Un été à retrouver.</span></div>
          <div class="floating-label"><span class="status-dot"></span> Un peu d’ordre. Beaucoup de souvenirs.</div>
          <div class="folder-card">
            <div class="folder-card-top"><span class="folder-icon" aria-hidden="true"></span><strong>Mes souvenirs</strong><span class="small-tag">CLASSÉS</span></div>
            <div class="folder-tree"><span>2026</span><span class="tree-child">2026-06</span><span class="tree-child selected">2026-07 <span aria-hidden="true">✓</span></span><span class="tree-child">2026-08</span></div>
          </div>
          <span class="art-caption">Moins de fichiers en vrac. Plus de souvenirs.</span>
        </div>
      </section>

      <div class="trust-strip">
        <div class="shell trust-inner"><span>Pensé pour vos photos, pas pour collecter vos données.</span><span>100 % local</span><span>Sans abonnement</span><span>Code ouvert</span></div>
      </div>

      <section class="section shell" id="classement" aria-labelledby="sorting-title">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">DU VRAC AUX SOUVENIRS</p><h2 id="sorting-title">Vos photos ont une histoire.<br /><span class="serif">Vos dossiers aussi.</span></h2></div>
          <p>Une structure simple, basée sur les métadonnées des photos. Pas sur la date à laquelle vous les avez copiées.</p>
        </div>
        <div class="comparison">
          <div class="file-panel before-panel">
            <div class="panel-heading"><span class="panel-dot"></span> Avant <span class="panel-subtitle">Un dossier, beaucoup de fichiers</span></div>
            <div class="file-list" aria-label="Exemple de fichiers avant classement">
              <span><span class="file-icon" aria-hidden="true">▧</span> IMG_3842.HEIC</span>
              <span><span class="file-icon" aria-hidden="true">▧</span> IMG_0921.JPG</span>
              <span><span class="file-icon" aria-hidden="true">▧</span> IMG_3843.HEIC</span>
              <span><span class="file-icon" aria-hidden="true">▧</span> IMG_1706.JPG</span>
            </div>
            <p class="panel-note">« C’était quand, déjà ? »</p>
          </div>
          <div class="comparison-arrow" aria-hidden="true">→</div>
          <div class="file-panel after-panel">
            <div class="panel-heading"><span class="status-dot"></span> Après <span class="panel-subtitle">Une place pour chaque moment</span></div>
            <div class="result-tree">
              <strong><span class="folder-icon" aria-hidden="true"></span> 2026</strong>
              <div class="result-branch">
                <strong><span class="folder-icon" aria-hidden="true"></span> 2026-07</strong>
                <code>2026-07-14 - iPhone - 1.heic</code>
                <code>2026-07-14 - iPhone - 2.heic</code>
              </div>
              <div class="result-branch">
                <strong><span class="folder-icon" aria-hidden="true"></span> 2026-08</strong>
                <code>2026-08-03 - iPhone - 1.jpg</code>
              </div>
            </div>
          </div>
        </div>
        <p class="example-note">Exemple illustratif. Les noms utilisent la date EXIF, le modèle d’appareil et un numéro ; les extensions sont normalisées en minuscules.</p>
      </section>

      <section class="benefits-section" aria-labelledby="benefits-title">
        <div class="shell section">
          <p class="eyebrow">SIMPLE PAR CHOIX</p>
          <h2 id="benefits-title">Du tri. <span class="serif">Pas de compromis.</span></h2>
          <div class="benefits-grid">
            {benefits.map((benefit) => <article class="benefit"><span class="number-label">{benefit.icon}</span><h3>{benefit.title}</h3><p>{benefit.text}</p></article>)}
          </div>
        </div>
      </section>

      <section class="section shell" id="fonctionnement" aria-labelledby="steps-title">
        <div class="section-heading centered"><p class="eyebrow">LAISSEZ LES MÉTADONNÉES TRAVAILLER</p><h2 id="steps-title">Trois étapes.<br /><span class="serif">Une bibliothèque plus claire.</span></h2></div>
        <ol class="steps-grid">
          {steps.map((step, index) => <li><span class="step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
        </ol>
        <aside class="info-note"><span aria-hidden="true">↳</span><p><strong>Le transfert et le classement sont deux étapes distinctes.</strong> Photosort ne se connecte pas directement à votre iPhone. Il organise les fichiers déjà récupérés sur votre ordinateur.</p></aside>
      </section>

      <section class="shell" id="communaute" aria-labelledby="community-title">
        <div class="community-card">
          <div><p class="eyebrow">FAIT POUR ÊTRE PARTAGÉ</p><h2 id="community-title">Un petit outil.<br /><span class="serif">Un projet ouvert à tous.</span></h2><p>Photosort est né d’un besoin simple : reprendre la main sur ses photos. Proposé en open source à la communauté, il peut grandir avec vos retours, vos idées et vos contributions.</p></div>
          <div class="community-aside"><span class="code-mark" aria-hidden="true">&lt;/&gt;</span><p>Utiliser. Explorer.<br />Améliorer. Partager.</p>
            {repositoryUrl ? <a class="button button-light" href={repositoryUrl} target="_blank" rel="noopener noreferrer">Explorer le code source <span aria-hidden="true">↗</span></a> : <a class="button button-light" href="#commencer">Découvrir le projet <span aria-hidden="true">↓</span></a>}
          </div>
        </div>
      </section>

      <section class="section shell start-section" id="commencer" aria-labelledby="start-title">
        <div><p class="eyebrow">POUR COMMENCER</p><h2 id="start-title">Votre prochain dossier ?<br /><span class="serif">Un peu mieux organisé.</span></h2><p>Une interface graphique pour choisir vos dossiers, ou une ligne de commande pour garder la main. Le même moteur de classement, dans les deux cas.</p>
          {repositoryUrl ? <a class="button button-primary" href={repositoryUrl} target="_blank" rel="noopener noreferrer">Accéder au projet et aux instructions <span aria-hidden="true">↗</span></a> : <p class="availability-note"><strong>Publication du dépôt à venir.</strong> Les liens vers le code source et les instructions d’installation seront ajoutés ici dès leur disponibilité.</p>}
        </div>
        <div class="terminal"><div class="terminal-bar"><span aria-hidden="true">● ● ●</span><span>Un aperçu de la ligne de commande</span></div><pre><code><span class="terminal-comment"># 1. Prévisualiser, sans rien écrire</span>
go run ./cmd/photosort \
  --source "./photos-iphone" \
  --destination "./photos-classees"

<span class="terminal-comment"># 2. Copier après vérification</span>
go run ./cmd/photosort \
  --source "./photos-iphone" \
  --destination "./photos-classees" \
  --apply</code></pre><p>Depuis le dépôt de l’application, avec Go installé à la version requise.</p></div>
      </section>

      <section class="section faq-section shell" id="questions" aria-labelledby="faq-title">
        <div><p class="eyebrow">EN TOUTE TRANSPARENCE</p><h2 id="faq-title">Avant de<br /><span class="serif">faire le tri.</span></h2><p>Ce que fait Photosort.<br />Et ce qu’il ne fait pas encore.</p></div>
        <div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span class="faq-plus" aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
      </section>
    </main>

    <footer class="site-footer shell"><a class="brand" href={home}><Image src={photosortIcon} width={30} height={30} densities={[1, 2, 3]} format="webp" loading="lazy" alt="" /><span>photosort.</span></a><p>Moins de désordre. Plus de souvenirs.</p><span>Un projet indépendant, non affilié à Apple.</span></footer>
  </body>
</html>
